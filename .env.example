# Config web de Firebase del proyecto falcon-crm
# (Consola de Firebase > Configuración del proyecto > Tus apps > App web > firebaseConfig).
# Estos valores no son secretos: la seguridad la ponen firestore.rules y storage.rules.
# Copiar a .env.local para desarrollo, o a .env.production para el build de despliegue.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=falcon-crm.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=falcon-crm
VITE_FIREBASE_STORAGE_BUCKET=falcon-crm.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Único correo con acceso. Debe coincidir con el de firestore.rules y storage.rules.
VITE_ALLOWED_EMAIL=carlos.falcon.tbp@gmail.com

# ---- Productos (Supabase, solo lectura con la anon key) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Tabla y columnas: ajustar al esquema real. Las opcionales pueden quedar vacías.
VITE_PRODUCTS_TABLE=productos
VITE_PRODUCTS_COL_ID=id
VITE_PRODUCTS_COL_NAME=nombre
VITE_PRODUCTS_COL_PRICE=precio
VITE_PRODUCTS_COL_IMAGE=imagen_url
VITE_PRODUCTS_COL_SKU=sku
VITE_PRODUCTS_COL_ACTIVE=
# Si la columna de imagen guarda una ruta (no una URL), bucket público de donde sale.
VITE_PRODUCTS_IMAGE_BUCKET=
# true si la columna de precio NO incluye IGV (se le suma el 18 %).
VITE_PRODUCTS_PRICE_WITHOUT_IGV=false
